# Clerk — https://dashboard.clerk.com -> Configure -> API keys
# Copy this file to .env.local and paste your own values below.
# The publishable key begins "pk_", the secret key begins "sk_".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tells Clerk where the custom <SignIn /> page lives
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
